<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.camp.campvision2.vigia</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/vigia.py</string>
    <string>--sem-painel</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Um LaunchAgent NAO le o seu ~/.zshrc: a chave precisa vir daqui. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key>
    <string>__CHAVE__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <!-- Como servico o processo nao herda o ssh-agent do login, entao o
         git fetch da auto-atualizacao precisa da chave apontada aqui. -->
    <key>GIT_SSH_COMMAND</key>
    <string>__GIT_SSH__</string>
    <key>HOME</key>
    <string>__CASA__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__CASA__/.campvision2/vigia.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CASA__/.campvision2/vigia.err.log</string>
</dict>
</plist>
